<%- include("partials/header") %>

<article class="post-full">
  <header class="post-header">
    <h1><%= post.title %></h1>
    <p class="post-meta">
      <time datetime="<%= post.publishedAt %>"><%= new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %></time>
      <% post.tags.forEach(function(tag) { %>
        <a href="/tags/<%= encodeURIComponent(tag) %>" class="tag-inline">#<%= tag %></a>
      <% }); %>
    </p>
  </header>

  <div class="post-body">
    <%- bodyHtml %>
  </div>

  <% if (isAdmin) { %>
    <div class="admin-actions">
      <a href="/admin/posts/<%= post.id %>/edit" class="btn">Edit</a>
    </div>
  <% } %>
</article>

<%- include("partials/footer") %>
