  </main>
  <footer class="site-footer">
    <div class="container">
      <% if (social && social.length) { %>
        <ul class="social-links">
          <% social.forEach(function(s) { %>
            <li><a href="<%= s.url %>" rel="me noopener" target="_blank"><%= s.name %></a></li>
          <% }); %>
        </ul>
      <% } %>
      <p class="copyright">© <%= site.author %> · <a href="/rss.xml">RSS feed</a></p>
    </div>
  </footer>
</body>
</html>
