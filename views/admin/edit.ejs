<%- include("../partials/header") %>

<section class="intro">
  <h1><%= isNew ? "New post" : "Edit post" %></h1>
</section>

<form method="post" action="<%= action %>" class="post-form">
  <label>
    Title
    <input type="text" name="title" value="<%= post.title %>" required>
  </label>

  <label>
    Date
    <input type="date" name="publishedAt" value="<%= post.publishedAt %>" required>
  </label>

  <label>
    Tags (comma-separated)
    <input type="text" name="tags" value="<%= post.tags.join(', ') %>" placeholder="typescript, web, career">
  </label>

  <label>
    Body (Markdown)
    <textarea name="description" id="description" rows="20" required><%= post.description %></textarea>
  </label>

  <fieldset class="upload-box">
    <legend>Upload image</legend>
    <input type="file" id="imageFile" accept="image/*">
    <button type="button" id="uploadBtn" class="btn">Upload &amp; insert</button>
    <p class="hint">
      Inserts Markdown. Prefix the alt text with <code>left|</code>, <code>right|</code>,
      <code>center|</code>, or <code>wide|</code> to control how text wraps:
      <code>![right|My caption](/images/photo.jpg)</code>
    </p>
    <span id="uploadStatus" class="hint"></span>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= isNew ? "Publish" : "Save" %></button>
    <a href="/admin" class="btn">Cancel</a>
  </div>
</form>

<script>
  document.getElementById("uploadBtn").addEventListener("click", async function () {
    var input = document.getElementById("imageFile");
    var status = document.getElementById("uploadStatus");
    if (!input.files || !input.files[0]) { status.textContent = "Choose a file first."; return; }
    status.textContent = "Uploading…";
    var fd = new FormData();
    fd.append("image", input.files[0]);
    try {
      var res = await fetch("/admin/upload", { method: "POST", body: fd });
      if (!res.ok) throw new Error("upload failed");
      var data = await res.json();
      var textarea = document.getElementById("description");
      var snippet = "\n\n![left|caption](" + data.url + ")\n\n";
      textarea.value += snippet;
      status.textContent = "Inserted " + data.url;
    } catch (e) {
      status.textContent = "Upload failed.";
    }
  });
</script>

<%- include("../partials/footer") %>
