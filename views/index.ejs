<%- include("partials/header") %>

<section class="intro">
  <h1><%= site.title %></h1>
  <p class="lead"><%= site.description %></p>
</section>

<% if (tags && tags.length) { %>
  <nav class="tag-cloud">
    <% tags.forEach(function(t) { %>
      <a href="/tags/<%= encodeURIComponent(t.name) %>" class="tag">#<%= t.name %> <span class="tag-count"><%= t.count %></span></a>
    <% }); %>
  </nav>
<% } %>

<section class="post-list">
  <% if (!posts.length) { %>
    <p class="empty">No posts yet.</p>
  <% } %>
  <% posts.forEach(function(post) { %>
    <article class="post-card">
      <h2><a href="/posts/<%= post.slug %>"><%= post.title %></a></h2>
      <p class="post-meta">
        <time datetime="<%= post.publishedAt %>"><%= new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %></time>
        <% post.tags.forEach(function(tag) { %>
          <a href="/tags/<%= encodeURIComponent(tag) %>" class="tag-inline">#<%= tag %></a>
        <% }); %>
      </p>
      <p class="excerpt"><%= post.excerpt %></p>
    </article>
  <% }); %>
</section>

<%- include("partials/footer") %>
