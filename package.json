{
  "name": "plain-blog",
  "version": "1.0.0",
  "description": "A simple, modern markdown blog for a software engineer",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^8.7.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "google-auth-library": "^8.9.0",
    "marked": "^4.3.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/marked": "^4.3.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^18.19.0",
    "@types/sanitize-html": "^2.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^0.34.6",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^0.34.6"
  }
}
