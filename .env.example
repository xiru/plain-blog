# --- Server ---
PORT=3000
# Public base URL the site responds on (used for permalinks, RSS, OAuth redirect).
SITE_URL=http://localhost:3000

# --- Site identity ---
SITE_TITLE=Fabiano Weimar
SITE_DESCRIPTION=Notes on software engineering and assorted topics.
SITE_AUTHOR=Fabiano Weimar

# --- Authentication (Google OAuth) ---
# Only this Google account can create/edit posts.
ADMIN_EMAIL=fabiano.weimar@gmail.com
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  <SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string used to sign the session cookie.
SESSION_SECRET=please-change-this-to-a-long-random-string

# --- Storage ---
DB_PATH=./data/blog.db
IMAGES_DIR=./images

# --- Social links (leave blank to hide) ---
SOCIAL_TWITTER=https://twitter.com/yourhandle
SOCIAL_GITHUB=https://github.com/yourhandle
SOCIAL_LINKEDIN=https://www.linkedin.com/in/yourhandle
SOCIAL_SLIDESHARE=https://www.slideshare.net/yourhandle
SOCIAL_FLICKR=https://www.flickr.com/photos/yourhandle
SOCIAL_FACEBOOK=https://www.facebook.com/yourhandle
SOCIAL_INSTAGRAM=https://www.instagram.com/yourhandle
